generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  ARCHIVED
}

enum PracticeType {
  PRACTICE
  LESSON_QUIZ
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
}

enum AIRequestType {
  TUTOR
  QUESTION_GENERATION
  MISTAKE_ANALYSIS
  LESSON_DRAFT
  TRANSCRIPT_ANALYSIS
}

enum QuestionPurpose {
  INITIAL
  DIAGNOSTIC
  REINFORCEMENT
  APPLICATION
  MASTERY
}

enum LessonContentKind {
  EXPLANATION
  EXAMPLE
  CALLOUT
  SUMMARY
  TEXT
  VIDEO
  IMAGE
  DOCUMENT
  INTERACTIVE
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_PRACTICE
  MASTERED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                UserRole
  displayName         String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  ownedClasses        Class[]              @relation("ClassTeacher")
  classMemberships    ClassMember[]
  lessons             Lesson[]             @relation("LessonAuthor")
  assignments         Assignment[]         @relation("AssignmentStudent")
  practiceSessions    PracticeSession[]
  quizAttempts        QuizAttempt[]
  masteryRecords      MasteryRecord[]
  chatConversations   ChatConversation[]
  authSessions        AuthSession[]
  lessonProgress      LessonProgress[]
  lessonCheckAttempts LessonCheckAttempt[]
  mistakeRecords      MistakeRecord[]
  aiInteractions      AIInteraction[]

  @@index([role])
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  studentNumber String?
  gradeLevel    String?
  section       String?
  schoolName    String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  department     String?
  title          String?
  specialization String?
  schoolName     String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Class {
  id          String        @id @default(cuid())
  name        String
  teacherId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  teacher     User          @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  members     ClassMember[]
  assignments Assignment[]

  @@index([teacherId])
}

model ClassMember {
  classId  String
  userId   String
  joinedAt DateTime @default(now())
  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

model Lesson {
  id                String               @id @default(cuid())
  authorId          String
  title             String
  description       String?
  subject           String
  gradeLevel        String
  position          Int                  @default(0)
  estimatedMinutes  Int?
  sourceTitle       String?
  sourceTranscript  String?
  status            LessonStatus         @default(DRAFT)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  publishedAt       DateTime?
  unitId            String?
  author            User                 @relation("LessonAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  unit              Unit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sections          LessonSection[]
  contents          LessonContent[]
  sources           LessonSource[]
  objectives        LearningObjective[]
  assessments       Assessment[]
  progress          LessonProgress[]
  practiceQuestions PracticeQuestion[]
  vocabulary        LessonVocabulary[]
  checks            LessonCheck[]
  checkAttempts     LessonCheckAttempt[]
  quizQuestions     QuizQuestion[]
  assignments       Assignment[]
  practiceSessions  PracticeSession[]
  quizAttempts      QuizAttempt[]
  chatConversations ChatConversation[]
  mistakes          MistakeRecord[]
  aiInteractions    AIInteraction[]

  @@index([authorId, status])
  @@index([subject, gradeLevel])
  @@index([unitId, status])
}

model Subject {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  curricula   Curriculum[]
}

model GradeLevel {
  id        String       @id @default(cuid())
  level     Int          @unique
  label     String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  curricula Curriculum[]
}

model Curriculum {
  id           String     @id @default(cuid())
  subjectId    String
  gradeLevelId String
  createdAt    DateTime   @default(now())
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  terms        Term[]

  @@unique([subjectId, gradeLevelId])
  @@index([gradeLevelId])
}

model Term {
  id           String     @id @default(cuid())
  curriculumId String
  number       Int
  title        String
  createdAt    DateTime   @default(now())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  units        Unit[]

  @@unique([curriculumId, number])
  @@index([curriculumId, number])
}

model Unit {
  id          String   @id @default(cuid())
  termId      String
  title       String
  description String?
  position    Int      @default(0)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  term        Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([termId, position])
  @@index([termId, position])
}

model LessonContent {
  id        String            @id @default(cuid())
  lessonId  String
  position  Int
  kind      LessonContentKind @default(EXPLANATION)
  heading   String?
  body      String
  mediaUrl  String?
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  lesson    Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
}

model LessonSource {
  id           String   @id @default(cuid())
  lessonId     String
  provider     String
  url          String
  title        String
  description  String?
  videoId      String?
  thumbnailUrl String?
  channelTitle String?
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Competency {
  id          String              @id @default(cuid())
  code        String?             @unique
  title       String
  description String?
  source      String?
  createdAt   DateTime            @default(now())
  objectives  LearningObjective[]
}

model LearningObjective {
  id            String             @id @default(cuid())
  lessonId      String
  competencyId  String?
  code          String?
  description   String
  position      Int                @default(0)
  createdAt     DateTime           @default(now())
  lesson        Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  competency    Competency?        @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  skills        ObjectiveSkill[]
  checks        LessonCheck[]
  quizQuestions QuizQuestion[]
  questions     PracticeQuestion[]

  @@unique([lessonId, position])
  @@index([competencyId])
  @@index([lessonId])
}

model Skill {
  id            String             @id @default(cuid())
  code          String?            @unique
  name          String             @unique
  description   String?
  objectives    ObjectiveSkill[]
  checks        LessonCheck[]
  quizQuestions QuizQuestion[]
  questions     PracticeQuestion[]
}

model ObjectiveSkill {
  objectiveId String
  skillId     String
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  skill       Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([objectiveId, skillId])
  @@index([skillId])
}

model Assessment {
  id               String         @id @default(cuid())
  lessonId         String
  title            String
  description      String?
  passingScore     Float          @default(70.0)
  timeLimitMinutes Int?
  status           LessonStatus   @default(PUBLISHED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]

  @@index([lessonId])
}

model LessonProgress {
  id                 String               @id @default(cuid())
  studentId          String
  lessonId           String
  status             LessonProgressStatus @default(IN_PROGRESS)
  latestScore        Float?
  bestScore          Float?
  practiceAttempts   Int                  @default(0)
  assessmentAttempts Int                  @default(0)
  masteryScore       Float                @default(0.0)
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  lastActivityAt     DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  student            User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson             Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, updatedAt])
  @@index([lessonId])
}

model LessonSection {
  id                String   @id @default(cuid())
  lessonId          String
  position          Int
  heading           String
  type              String   @default("TEXT")
  content           String?
  metadata          Json?
  sourceExplanation String?
  aiExplanation     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, position])
  @@index([lessonId])
}

model LessonVocabulary {
  id         String @id @default(cuid())
  lessonId   String
  term       String
  definition String
  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, term])
  @@index([lessonId])
}

model LessonCheck {
  id                  String               @id @default(cuid())
  lessonId            String
  position            Int
  question            String
  questionType        QuestionType         @default(MULTIPLE_CHOICE)
  options             Json
  correctIndex        Int                  @default(0)
  correctAnswer       String?
  explanation         String
  points              Int                  @default(1)
  learningObjectiveId String?
  skillId             String?
  purpose             QuestionPurpose      @default(INITIAL)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  lesson              Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective?   @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)
  skill               Skill?               @relation(fields: [skillId], references: [id], onDelete: SetNull)
  attempts            LessonCheckAttempt[]

  @@unique([lessonId, position])
  @@index([lessonId])
}

/// A student's graded attempt at a lesson knowledge check. Correctness is decided by
/// the server (never trusted from the client) and drives lesson completion.
model LessonCheckAttempt {
  id            String      @id @default(cuid())
  studentId     String
  lessonId      String
  checkId       String
  selectedIndex Int?
  answerText    String?
  correct       Boolean
  answeredAt    DateTime    @default(now())
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson        Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  check         LessonCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([studentId, lessonId, correct])
  @@index([checkId])
}

model QuizQuestion {
  id                  String             @id @default(cuid())
  lessonId            String
  position            Int
  question            String
  questionType        QuestionType       @default(MULTIPLE_CHOICE)
  difficulty          String             @default("MEDIUM")
  options             Json
  correctIndex        Int
  correctAnswer       String?
  explanation         String
  skill               String?
  learningObjectiveId String?
  skillId             String?
  purpose             QuestionPurpose    @default(INITIAL)
  assessmentId        String?
  lesson              Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)
  skillRecord         Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  assessment          Assessment?        @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  assessmentAnswers   AssessmentAnswer[]

  @@unique([lessonId, position])
  @@index([lessonId])
}

model Assignment {
  id        String           @id @default(cuid())
  lessonId  String
  classId   String
  studentId String?
  status    AssignmentStatus @default(ACTIVE)
  dueAt     DateTime?
  createdAt DateTime         @default(now())
  lesson    Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User?            @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, classId, studentId])
  @@index([classId, status])
  @@index([studentId, status])
}

model PracticeSession {
  id          String             @id @default(cuid())
  studentId   String
  lessonId    String?
  subject     String
  topic       String
  difficulty  String
  type        PracticeType       @default(PRACTICE)
  total       Int
  correct     Int                @default(0)
  startedAt   DateTime           @default(now())
  completedAt DateTime?
  student     User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions   PracticeQuestion[]
  answers     PracticeAnswer[]
  mistakes    MistakeRecord[]

  @@index([studentId, startedAt])
  @@index([lessonId])
}

model PracticeQuestion {
  id                  String             @id @default(cuid())
  sessionId           String
  question            String
  questionType        QuestionType       @default(MULTIPLE_CHOICE)
  options             Json
  correctIndex        Int
  correctAnswer       String?
  skill               String?
  explanation         String?
  learningObjective   String?
  lessonId            String?
  learningObjectiveId String?
  skillId             String?
  purpose             QuestionPurpose    @default(DIAGNOSTIC)
  difficulty          String
  createdAt           DateTime           @default(now())
  session             PracticeSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lesson              Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  learningTarget      LearningObjective? @relation(fields: [learningObjectiveId], references: [id], onDelete: SetNull)
  skillRecord         Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  answer              PracticeAnswer?

  @@index([sessionId, createdAt])
  @@index([lessonId])
  @@index([learningObjectiveId, skillId])
}

model PracticeAnswer {
  id               String            @id @default(cuid())
  sessionId        String
  questionId       String?           @unique
  question         String
  options          Json
  correctIndex     Int
  selectedIndex    Int
  correct          Boolean
  skill            String?
  explanation      String?
  answeredAt       DateTime          @default(now())
  session          PracticeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  practiceQuestion PracticeQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([sessionId, answeredAt])
}

model QuizAttempt {
  id           String             @id @default(cuid())
  studentId    String
  lessonId     String
  assessmentId String?
  correct      Int                @default(0)
  total        Int
  score        Float              @default(0)
  passed       Boolean            @default(false)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  student      User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  assessment   Assessment?        @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  answers      AssessmentAnswer[]
  mistakes     MistakeRecord[]

  @@index([studentId, startedAt])
  @@index([lessonId])
}

model AssessmentAnswer {
  id            String       @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int?
  textAnswer    String?
  numericAnswer Float?
  isCorrect     Boolean
  score         Float        @default(0)
  answeredAt    DateTime     @default(now())
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model MistakeRecord {
  id                  String           @id @default(cuid())
  studentId           String
  lessonId            String?
  questionId          String?
  assessmentAttemptId String?
  practiceSessionId   String?
  submittedAnswer     String
  correctReference    String?
  category            String?
  analysis            String?
  resolved            Boolean          @default(false)
  createdAt           DateTime         @default(now())
  resolvedAt          DateTime?
  student             User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson              Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  assessmentAttempt   QuizAttempt?     @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  practiceSession     PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: SetNull)

  @@index([studentId, lessonId])
  @@index([studentId, resolved])
}

model AIInteraction {
  id           String        @id @default(cuid())
  userId       String
  lessonId     String?
  requestType  AIRequestType
  model        String
  promptTokens Int?
  outputTokens Int?
  latencyMs    Int?
  success      Boolean       @default(true)
  metadata     Json?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, requestType])
  @@index([userId, createdAt])
}

model MasteryRecord {
  id            String   @id @default(cuid())
  studentId     String
  subject       String
  topic         String
  mastery       Int      @default(0)
  understanding Int      @default(0)
  accuracy      Int      @default(0)
  application   Int      @default(0)
  consistency   Int      @default(0)
  updatedAt     DateTime @updatedAt
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, topic])
  @@index([studentId, subject])
}

model ChatConversation {
  id        String        @id @default(cuid())
  studentId String
  lessonId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@index([studentId, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
