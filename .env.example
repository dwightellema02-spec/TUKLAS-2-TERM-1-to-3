# ==============================================================================
# Tuklas 2.0 — Environment Configuration Template
# Copy this file to .env.local for local development.
# CRITICAL SECURITY RULE: NEVER commit actual secret values or keys to source control.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/tuklas"

# Authentication Secret (Must be at least 32 characters long)
# Generate using: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-characters-for-session-signing"

# Anthropic Claude API (Optional for core curriculum; required for AI Tutor & Generation)
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Application URL & Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Seed Configuration (Set to true only when running initial development seed)
ALLOW_DEMO_SEED=false

# Isolated database used by `npm test` (name must end in _test; it is truncated every run)
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/tuklas_v2_test"

# Teacher self-registration invite code. There is NO default: if unset or blank, teacher registration is disabled.
TEACHER_INVITE_CODE=""

# Number of reverse proxies you control in front of the app (Vercel/nginx = 1). The client IP is taken from
# X-Forwarded-For at this position from the right; entries to its left are client-controlled and ignored.
TRUSTED_PROXY_HOPS=1

# AI backend: "anthropic" (default) or "gemini". A missing key makes AI features return 503 -- never a fake reply.
AI_PROVIDER="anthropic"
# Gemini needs BOTH a key and an explicit, operator-verified model name (no default is assumed).
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Optional: send Anthropic requests through a proxy / test double. Leave blank for the real API.
ANTHROPIC_BASE_URL=""
